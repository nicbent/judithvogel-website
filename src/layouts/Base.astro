---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description = 'Judith Vogel – Heilpraktikerin für Psychotherapie, systemische Beraterin und Coach in Hamburg. Therapie. Beratung. Coaching.', image = '/images/home.jpg' } = Astro.props;
const fullTitle = title ? `${title} — Judith Vogel` : 'Judith Vogel';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  { href: '/', label: 'JV' },
  { href: '/philosophie', label: 'Philosophie' },
  { href: '/ueber-mich', label: 'Über mich' },
  { href: '/angebot', label: 'Angebot' },
  { href: '/kontakt', label: 'Kontakt' },
  { href: '/vogelperspektiven', label: 'Vogelperspektiven' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---
<!doctype html>
<html lang="de" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
  </head>
  <body>
    <a class="hp" href="#inhalt">Zum Inhalt springen</a>
    <header class="site-header">
      <a class="brand" href="/">JV</a>
      <nav class="nav" aria-label="Hauptnavigation">
        {nav.map((n) => (
          <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
      <button class="menu-toggle" aria-label="Menü öffnen" aria-expanded="false">
        <span></span><span></span>
      </button>
    </header>

    <main id="inhalt">
      <slot />
    </main>

    <footer class="site-footer">
      <nav aria-label="Rechtliches">
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
      </nav>
      <p>©{new Date().getFullYear()} Judith Vogel</p>
    </footer>

    <script is:inline>
      // Menü auf dem Handy
      const t = document.querySelector('.menu-toggle');
      t.addEventListener('click', () => {
        const open = document.body.classList.toggle('menu-open');
        t.setAttribute('aria-expanded', open);
        t.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
      });
      // Sanftes Einblenden der Inhalte
      const els = [...document.querySelectorAll('.fade')];
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.filter((e) => e.isIntersecting).forEach((e, i) => {
            e.target.style.transitionDelay = `${0.08 * i}s`;
            e.target.classList.add('in');
            io.unobserve(e.target);
          });
        }, { rootMargin: '0px 0px -5% 0px' });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
